{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "vendor/**",
    "node_modules/**",
    "coverage/**",
    "coverage-html/**",
    "build/**"
  ],
  "config": {
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": [
        "x-docs-banner"
      ]
    }
  }
}
